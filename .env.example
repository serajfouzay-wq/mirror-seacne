PORT=3000
# Password for the admin page and admin API
MOSAIC_ADMIN_KEY=change-me
# Optional separate key for server-to-server calls from your RSVP system
MOSAIC_API_KEY=
# Where photos + db.json are stored
MOSAIC_DATA_DIR=./data
# Serve under a sub path (e.g. /mosaic) when running standalone
BASE_PATH=
# Optional: POSTed with JSON {type:"photo.created", photo} on every new photo
MOSAIC_WEBHOOK_URL=
# Comma separated origins the guest page may redirect back to (?redirect=...)
MOSAIC_REDIRECT_ORIGINS=https://rsvp.example.com
MOSAIC_MAX_UPLOAD_MB=6
MOSAIC_TITLE=Photo Wall
